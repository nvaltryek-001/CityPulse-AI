# GEMINI_API_KEY: Required for Gemini AI API calls (waste-photo analysis).
# Free tier available. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: Required for "Continue with Google" sign-in.
# This is the WEB client ID (not the Android one), auto-created by Firebase
# when you enable Google as a sign-in provider.
# Firebase Console -> Authentication -> Sign-in method -> Google -> enable it
# -> copy "Web client ID" shown there.
GOOGLE_WEB_CLIENT_ID=MY_GOOGLE_WEB_CLIENT_ID

# OPENWEATHER_API_KEY: Required for live AQI + Weather on the Dashboard.
# Free tier: 1,000 calls/day, no credit card required.
# Get a key at https://home.openweathermap.org/users/sign_up
# Note: new keys can take up to 2 hours to activate.
OPENWEATHER_API_KEY=MY_OPENWEATHER_API_KEY

rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the free Firebase CLI: npm install -g firebase-tools)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- users/{uid} ---
    // A user can read/update their own profile. Nobody can delete a
    // profile from the client. Admins can read any profile (needed for
    // the future Admin Dashboard).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // --- reports/{reportId} (waste reports -- wired up in a later phase) ---
    // Any signed-in user can create a report and read the public feed;
    // only the report's owner or an admin can edit/delete it.
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- aqi/{uid}, weather/{uid} ---
    // Each user's own latest reading, used as an offline cache by the
    // Dashboard. A user can only read/write their own cached document.
    match /aqi/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /weather/{uid} {
      allow read, write: if isOwner(uid);
    }

    // --- Everything else added in later phases (notifications, leaderboard,
    // news cache, etc.) defaults to admin-only writes, signed-in reads,
    // until each feature's own rule block is added here. ---
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
